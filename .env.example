# Copy to .env and adjust. Used by docker compose and by `uv run twin` on the host.
POSTGRES_USER=twin
POSTGRES_PASSWORD=twin_dev_password
POSTGRES_DB=twin
HAPI_DB=hapi
PG_PORT=5432
FHIR_PORT=8080

# App settings (the pipeline and replay run on the host and connect via localhost).
# DATABASE_URL may be postgresql:// or postgresql+asyncpg:// (asyncpg is used either way).
DATABASE_URL=postgresql://twin:twin_dev_password@localhost:5432/twin
FHIR_BASE=http://localhost:8080/fhir
DATA_DIR=./data
REPLAY_SPEED=60
