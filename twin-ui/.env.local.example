# Twin API (`uv run twin serve`), used by the Next server and the /api/twin rewrite
TWIN_API_URL=http://127.0.0.1:8765
# WebSocket base for the live twin, used by the browser
NEXT_PUBLIC_TWIN_WS_URL=ws://127.0.0.1:8765
# Clinic time zone for displayed times (the twin's twin-time zone)
NEXT_PUBLIC_TWIN_TZ=America/Chicago
