  "cards": [
    {
      "dot": "emerald",
      "title": "Real sensor path",
      "items": [
        "CGMacros and BIG IDEAs supply real CGM and wrist-worn sensor data",
        "Two-CGM patients are fused onto the Dexcom scale",
        "NHANES adds a 1,879-person real population for models"
      ]
    },
    {
      "dot": "amber",
      "title": "Synthetic, always flagged",
      "items": [
        "Synthea supplies EHR history for the 30 composite twins",
        "The rule-based generator fills sleep, SpO2, respiration, stress and HRV gaps",
        "Generated rows sit under an is_synthetic device and FHIR tag"
      ]
    },
    {
      "dot": "violet",
      "title": "Consumers",
      "items": [
        "Twin API serves the per-patient view, timeline and replay",
